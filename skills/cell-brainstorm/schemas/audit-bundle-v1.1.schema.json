{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cell-brainstorm:audit-bundle:1.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "run": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "live",
            "replay",
            "offline",
            "synthetic"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "report_created_at": {
          "type": "string",
          "format": "date-time"
        },
        "final_checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "query_log_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "coverage_limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_channels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "run_id",
        "mode",
        "model_id",
        "as_of",
        "report_created_at",
        "final_checked_at",
        "snapshot_id",
        "query_log_refs",
        "coverage_limitations",
        "source_channels"
      ],
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "properties": {
        "research_content": {
          "type": "string",
          "minLength": 1
        },
        "domain_profile": {
          "type": "string",
          "minLength": 1
        },
        "known_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "unknown_resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "research_content",
        "domain_profile",
        "known_resources",
        "unknown_resources",
        "exclusions"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "study_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "first_public_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "version_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "access": {
            "type": "string",
            "enum": [
              "metadata",
              "abstract",
              "excerpt",
              "fulltext"
            ]
          },
          "source_type": {
            "type": "string",
            "enum": [
              "primary",
              "preprint",
              "review",
              "registry",
              "metadata"
            ]
          },
          "integrity": {
            "type": "string",
            "enum": [
              "checked",
              "unknown",
              "retracted",
              "concern"
            ]
          },
          "verified_metadata": {
            "type": "boolean"
          },
          "content_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "study_id",
          "title",
          "url",
          "first_public_date",
          "version_date",
          "access",
          "source_type",
          "integrity",
          "verified_metadata",
          "content_sha256",
          "retrieved_at"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question_key": {
            "type": "string",
            "minLength": 1
          },
          "primary_gap_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "gap": {
            "type": "string",
            "minLength": 1
          },
          "novelty_delta": {
            "type": "string",
            "minLength": 1
          },
          "why_it_matters": {
            "type": "string",
            "minLength": 1
          },
          "novelty_confidence": {
            "type": "string",
            "enum": [
              "high",
              "moderate",
              "low",
              "unknown"
            ]
          },
          "novelty_queries_complete": {
            "type": "boolean"
          },
          "critical_comparison_verified": {
            "type": "boolean"
          },
          "nearest_work": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "what_done": {
                  "type": "string",
                  "minLength": 1
                },
                "remaining_delta": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "overlap": {
                  "type": "string",
                  "enum": [
                    "full",
                    "partial",
                    "adjacent",
                    "unknown"
                  ]
                }
              },
              "required": [
                "source_id",
                "what_done",
                "remaining_delta",
                "locator",
                "overlap"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 5
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "known",
                    "inference",
                    "hypothesis"
                  ]
                },
                "citations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "locator": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source_id",
                      "locator"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "text",
                "kind",
                "citations"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "design": {
            "type": "object",
            "properties": {
              "key_test": {
                "type": "string",
                "minLength": 1
              },
              "main_readout": {
                "type": "string",
                "minLength": 1
              },
              "controls": {
                "type": "string",
                "minLength": 1
              },
              "alternative_explanation": {
                "type": "string",
                "minLength": 1
              },
              "orthogonal_test": {
                "type": "string",
                "minLength": 1
              },
              "falsifier": {
                "type": "string",
                "minLength": 1
              },
              "first_step": {
                "type": "string",
                "minLength": 1
              },
              "continue_if": {
                "type": "string",
                "minLength": 1
              },
              "stop_if": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "key_test",
              "main_readout",
              "controls",
              "alternative_explanation",
              "orthogonal_test",
              "falsifier",
              "first_step",
              "continue_if",
              "stop_if"
            ],
            "additionalProperties": false
          },
          "resources": {
            "type": "object",
            "properties": {
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "confirmed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "critical_unknowns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              }
            },
            "required": [
              "required",
              "confirmed",
              "missing",
              "critical_unknowns"
            ],
            "additionalProperties": false
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "ratings": {
            "type": "object",
            "properties": {
              "N": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "level",
                  "rationale",
                  "source_ids"
                ],
                "additionalProperties": false
              },
              "V": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "level",
                  "rationale",
                  "source_ids"
                ],
                "additionalProperties": false
              },
              "F": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "level",
                  "rationale",
                  "source_ids"
                ],
                "additionalProperties": false
              },
              "T": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "level",
                  "rationale",
                  "source_ids"
                ],
                "additionalProperties": false
              },
              "E": {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "level",
                  "rationale",
                  "source_ids"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "N",
              "V",
              "F",
              "T",
              "E"
            ],
            "additionalProperties": false
          },
          "checks": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              },
              "premise_support": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              },
              "novelty_delta": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              },
              "counterevidence": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              },
              "discriminating_design": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              },
              "resource_fit": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              },
              "integrity": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              },
              "ethics": {
                "type": "string",
                "enum": [
                  "pass",
                  "unknown",
                  "fail"
                ]
              }
            },
            "required": [
              "scope",
              "premise_support",
              "novelty_delta",
              "counterevidence",
              "discriminating_design",
              "resource_fit",
              "integrity",
              "ethics"
            ],
            "additionalProperties": false
          },
          "audit_summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "question_key",
          "primary_gap_id",
          "title",
          "question",
          "hypothesis",
          "gap",
          "novelty_delta",
          "why_it_matters",
          "novelty_confidence",
          "novelty_queries_complete",
          "critical_comparison_verified",
          "nearest_work",
          "claims",
          "design",
          "resources",
          "risks",
          "ratings",
          "checks",
          "audit_summary"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "single_model_sequential"
        },
        "generator_model_id": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_model_id": {
          "type": "string",
          "minLength": 1
        },
        "review_type": {
          "const": "same_model_self_audit"
        },
        "independent_review": {
          "const": false
        },
        "context_mode": {
          "enum": [
            "same_context",
            "fresh_context"
          ]
        },
        "exposed_to_previous_scores": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "generator_model_id",
        "reviewer_model_id",
        "review_type",
        "independent_review",
        "context_mode",
        "exposed_to_previous_scores"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run",
    "brief",
    "sources",
    "candidates",
    "execution"
  ],
  "additionalProperties": false
}
